# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://bestiabase:!ChangeMe!@127.0.0.1:3306/bestiabase?serverVersion=9.7.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/blast ###
# Directory dei binari NCBI BLAST+ (blastn, makeblastdb, blastdbcmd...). NON vendorizzati in git:
# sovrascrivere in .env.local con il path reale della macchina.
BLAST_BIN_DIR=/usr/local/ncbi/blast/bin
###< app/blast ###

###> app/redis ###
REDIS_URL=redis://127.0.0.1:6379
###< app/redis ###

###> app/blast-limits ###
# Dimensione massima di un input FASTA (query o soggetto), in byte: 15 MiB.
# Non superare: il FASTA normalizzato va in colonne MEDIUMTEXT (16 MiB) e il normalizzatore usa
# circa 3 volte l'input in memoria. I file FASTA grandi si caricano da CLI con app:blast:import-db.
BLAST_FASTA_MAX_BYTES=15728640
# Dimensione massima della query incollata nel form web, in byte: 10 MiB. Richiede
# post_max_size >= 12M nel php.ini di PHP-FPM (vedi README).
BLAST_QUERY_MAX_BYTES=10485760
# Durata massima di un processo BLAST+, in secondi.
BLAST_TIMEOUT=3600
# Directory di lavoro dei job (fuori dalla document root).
BLAST_VAR_DIR=%kernel.project_dir%/var/blast
# Giorni dopo cui app:blast:cleanup elimina i job terminati.
BLAST_JOB_RETENTION_DAYS=30
# Ricerche ammesse dal web per indirizzo IP nell'intervallo indicato.
BLAST_SEARCH_RATE_LIMIT=20
BLAST_SEARCH_RATE_INTERVAL="10 minutes"
###< app/blast-limits ###

###> app/blast-databases ###
# Volumi dei database BLAST registrati: {BLAST_DB_DIR}/{nucleotide|protein}/{code}.
# Fuori da var/ (che si può svuotare senza perdere dati) e fuori da git. Nel DB i path sono
# relativi a questa directory: per spostare i volumi basta spostarli e cambiare il valore.
# In produzione usare un volume dedicato, es. /srv/bestiabase/blastdb.
BLAST_DB_DIR=%kernel.project_dir%/blastdb
###< app/blast-databases ###

###> symfony/lock ###
# Lock per job (un solo worker per job), su Redis: condiviso tra worker su più host.
LOCK_DSN=redis://127.0.0.1:6379
###< symfony/lock ###

###> app/mailer ###
# Mittente delle e-mail dell'applicazione; deve essere un indirizzo accettato dal provider SMTP.
MAILER_FROM_ADDRESS=no-reply@bestiabase.example
###< app/mailer ###

###> app/altcha ###
# Chiave con cui si firmano le sfide ALTCHA (proof of work): una stringa casuale per macchina, in
# .env.local. Mai riusare quella di un altro progetto.
ALTCHA_KEY=!ChangeMe!
# Difficoltà per scopo: low, medium, medium_high, high, very_high (vedi App\Service\Altcha\AltchaDifficulty).
ALTCHA_LOGIN_DIFFICULTY=medium_high
ALTCHA_REGISTRATION_DIFFICULTY=medium_high
# Verifica di sicurezza prima della home per gli anonimi.
ALTCHA_SECURITY_CHECK_DIFFICULTY=high
# Pagina "nopainnogain" dei 404: pensata per far sprecare CPU ai bot.
ALTCHA_TRAP_DIFFICULTY=very_high
# Durata, in secondi, del cookie che prova il superamento della verifica di sicurezza.
SECURITY_CHECK_COOKIE_LIFETIME=3600
###< app/altcha ###

###> symfony/slack-notifier ###
# SLACK_DSN=slack://TOKEN@default?channel=CHANNEL
# Handler Monolog `slack_error` (livello error). Il token reale va in .env.local o nel vault, mai qui.
SLACK_TOKEN=!ChangeMe!
SLACK_CHANNEL=bestiabase-error-log
SLACK_BOT_NAME=bestiabase
###< symfony/slack-notifier ###
