{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block altcha_script %}{{ include('_partials/altcha_script.html.twig') }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5" data-controller="altcha">
            <h1 class="h3 mb-3">Create an account</h1>
            <p class="text-body-secondary">After registering you can sign in, but an administrator has to enable your account before you can run searches.</p>

            {# Il widget sta fuori dal form: altrimenti ne aggiungerebbe un campo suo. #}
            <div class="mb-3">{{ include('_partials/altcha.html.twig', {challenge: altcha_challenge}) }}</div>

            {{ form_start(form, {attr: {'data-altcha-target': 'form', 'data-turbo': 'false'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.email) }}
                {{ form_row(form.username) }}
                {{ form_row(form.password) }}
                {{ form_widget(form.altcha, {attr: {'data-altcha-target': 'field'}}) }}
                {{ form_errors(form.altcha) }}
                <button class="btn btn-primary w-100" type="submit" data-altcha-target="submit" disabled>Register</button>
            {{ form_end(form) }}

            <p class="mt-3 small">Already registered? <a href="{{ path('app_login') }}">Sign in</a></p>
        </div>
    </div>
{% endblock %}
