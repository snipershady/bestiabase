{% extends 'base.html.twig' %}

{% block title %}Forgot your password{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <h1 class="h3 mb-3">Forgot your password?</h1>

            {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.email) }}
                <button class="btn btn-primary w-100" type="submit">Send the reset link</button>
            {{ form_end(form) }}

            <p class="mt-3 small"><a href="{{ path('app_login') }}">Back to sign in</a></p>
        </div>
    </div>
{% endblock %}
