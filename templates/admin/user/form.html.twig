{% extends 'base.html.twig' %}

{% block title %}{{ user ? 'Edit ' ~ user.email : 'New user' }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Administration</h1>
    {% include 'admin/_nav.html.twig' %}

    <h2 class="h5">{{ user ? user.email : 'New user' }}</h2>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.email) }}
        {{ form_row(form.username) }}
        {{ form_row(form.password) }}
        {{ form_row(form.admin) }}
        {{ form_row(form.active) }}
        {{ form_row(form.databases, {help: 'Public databases are available to everyone; administrators can search all databases.'}) }}
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-outline-secondary" href="{{ path('app_admin_users') }}">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
