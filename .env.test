# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Workspace e volumi BLAST dei test, separati da quelli di sviluppo
BLAST_VAR_DIR=%kernel.project_dir%/var/test/blast
BLAST_DB_DIR=%kernel.project_dir%/var/test/blastdb

# Messenger sincrono in memoria: i test ispezionano i messaggi senza un worker
MESSENGER_TRANSPORT_DSN=in-memory://
# Limiti bassi per poterli superare nei test funzionali
BLAST_QUERY_MAX_BYTES=2000
BLAST_SEARCH_RATE_LIMIT=3
